rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each hunter document is readable/writable only by the signed-in user it belongs to.
    match /hunters/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Everything else is denied by default (no other match blocks).
  }
}
